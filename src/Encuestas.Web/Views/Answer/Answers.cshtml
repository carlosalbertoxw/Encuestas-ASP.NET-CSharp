@model AnswersViewModel
@{
    ViewData["Title"] = $"Respuestas: {Model.Poll.Title}";
    var pager = PagerViewModel.For(Model.Answers, new Dictionary<string, string> { ["id"] = Model.Poll.Id.ToString(System.Globalization.CultureInfo.InvariantCulture) });
}
<div class="mt-3">
    <partial name="_Message" />
    <h4 class="text-center mb-1">@ViewData["Title"]</h4>
    <p class="text-center text-secondary">@Model.Answers.TotalCount respuesta(s)</p>

    @if (Model.Answers.TotalCount == 0)
    {
        <p class="text-center text-secondary">Esta encuesta aún no tiene respuestas.</p>
    }
    @foreach (var item in Model.Answers.Items)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <strong>@item.UserName</strong>
                    <span class="stars" title="@item.Stars de 5 estrellas">
                        @for (var i = 1; i <= 5; i++)
                        {
                            @(i <= item.Stars ? "★" : "☆")
                        }
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(item.Comment))
                {
                    <p class="card-text mt-2 mb-0">@item.Comment</p>
                }
            </div>
        </div>
    }

    <partial name="_Pager" model="pager" />
</div>

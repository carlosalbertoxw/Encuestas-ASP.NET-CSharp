# Copia este archivo a .env para personalizar el entorno local de Docker.
# Valores solo para desarrollo; usa credenciales fuertes en producción.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=encuestas
MYSQL_USER=encuestas
MYSQL_PASSWORD=encuestas
MYSQL_PORT=3306
WEB_PORT=8080
# URL pública de la aplicación; con ella se construyen los enlaces de los correos.
# Si cambias WEB_PORT, cámbiala también.
APP_BASE_URL=http://localhost:8080
# Puertos de Mailpit (SMTP y la interfaz web donde se leen los correos).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 sobre Microsoft.Testing.Platform (activado en global.json): cada
         proyecto de pruebas es un ejecutable. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Testcontainers.MySql" Version="4.16.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Encuestas.Web\Encuestas.Web.csproj" />
    <ProjectReference Include="..\..\src\Encuestas.Data\Encuestas.Data.csproj" />
    <ProjectReference Include="..\..\src\Encuestas.Model\Encuestas.Model.csproj" />
  </ItemGroup>

</Project>
